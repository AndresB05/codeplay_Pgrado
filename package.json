{
  "name": "codeplay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo de CodePlay: plataforma web para aprender a programar jugando.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "npm run dev -w @codeplay/web",
    "build": "npm run build -w @codeplay/web",
    "preview": "npm run preview -w @codeplay/web",
    "lint": "npm run lint -w @codeplay/web",
    "test": "npm run test -w @codeplay/web",
    "test:run": "npm run test:run -w @codeplay/web",
    "format": "npm run format -w @codeplay/web"
  }
}
