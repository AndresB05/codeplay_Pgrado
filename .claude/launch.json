{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "codeplay-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "codeplay-web-devtools",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@codeplay/web", "--", "--port", "5174", "--strictPort"],
      "env": { "VITE_ENABLE_DEV_TOOLS": "true" },
      "port": 5174
    },
    {
      "name": "codeplay-web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "-w", "@codeplay/web", "--", "--port", "4173", "--strictPort"],
      "port": 4173
    }
  ]
}
