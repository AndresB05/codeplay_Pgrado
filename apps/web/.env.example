VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# «Sin login» y Laboratorio 3D, apagados salvo que esto valga true (sólo en desarrollo).
VITE_ENABLE_DEV_TOOLS=

# Cuentas de prueba del acceso «Sin login». Opcionales y sólo de desarrollo:
# sin ellas se entra con la marca de invitado, como hasta ahora. Sus valores
# viven en .env, que no está en el repositorio, y nunca aquí.
VITE_DEV_TUTOR_EMAIL=
VITE_DEV_TUTOR_PASSWORD=
VITE_DEV_CHILD_EMAIL=
VITE_DEV_CHILD_PASSWORD=
