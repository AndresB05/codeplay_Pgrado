# Normaliza finales de linea: LF en el repositorio para todo el equipo.
# Evita diffs fantasma entre Windows y el entorno de despliegue (Linux).
* text=auto eol=lf

# Scripts que deben conservar finales de linea nativos de Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios: nunca tocar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.woff binary
*.woff2 binary
*.mp3 binary
*.wav binary
*.mp4 binary

# Modelos 3D del juego (apps/web/public/models). Declarados a mano y no dejados
# a la autodeteccion de text=auto: son 482 archivos y basta que uno se cuele
# como texto para que la conversion de finales de linea lo corrompa.
*.glb binary
*.gltf text
